#!/bin/bash

set -euo pipefail

event="${1-}"
case "$event" in
  state)
    [[ $# -eq 3 && "$2" =~ ^[0-9]+$ && "$3" =~ ^[0-9]+$ ]] || exit 64
    ;;
  *)
    printf 'usage: which-key-trigger state SEQUENCE MASK\n' >&2
    exit 64
    ;;
esac

shell_command="${OMARCHY_WHICH_KEY_SHELL:-omarchy-shell}"
exec "$shell_command" huacnlee.which-key "$@"
