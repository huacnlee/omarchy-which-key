#!/bin/bash

set -euo pipefail

begin_marker='-- omarchy-which-key:begin'
end_marker='-- omarchy-which-key:end'
config="${OMARCHY_WHICH_KEY_HYPR_CONFIG:-${HOME}/.config/hypr/bindings.lua}"
config_dir="$(dirname "$config")"
state_file="${config}.omarchy-which-key.state"
backup_file="${config}.omarchy-which-key.original"
xkbcli_command="${OMARCHY_WHICH_KEY_XKBCLI:-xkbcli}"
hyprctl_command="${OMARCHY_WHICH_KEY_HYPRCTL:-hyprctl}"

if [[ -L "$config" ]]; then
  printf 'install-bindings: refusing to replace symlinked config: %s\n' "$config" >&2
  exit 73
fi

mkdir -p "$config_dir"
if [[ ! -e "$config" ]]; then
  printf '%s\n' absent >"$state_file"
  : >"$config"
elif [[ ! -e "$state_file" ]]; then
  if [[ -s "$config" ]] && [[ "$(tail -c 1 -- "$config" | wc -l)" -eq 0 ]]; then
    printf '%s\n' no-final-newline >"$state_file"
  else
    printf '%s\n' final-newline >"$state_file"
  fi
fi

if ! grep -Fqx -- "$begin_marker" "$config"; then
  cp -p -- "$config" "$backup_file"
fi

temporary="$(mktemp "${config}.tmp.XXXXXX")"
keymap="$(mktemp)"
modmaps="$(mktemp)"
entries="$(mktemp)"
cleanup() {
  rm -f -- "$temporary" "$keymap" "$modmaps" "$entries"
}
trap cleanup EXIT

xkb_args=()
for option in kb_model kb_layout kb_variant kb_options; do
  value="$($hyprctl_command getoption -j "input:$option" 2>/dev/null | jq -r '.str // empty')"
  [[ -n "$value" ]] && xkb_args+=("--${option#kb_}" "$value")
done
"$xkbcli_command" compile-keymap "${xkb_args[@]}" >"$keymap"
"$xkbcli_command" compile-keymap "${xkb_args[@]}" --modmaps >"$modmaps"

awk '
  FNR == NR {
    if (match($0, /<([A-Za-z0-9_]+)>[[:space:]]*=[[:space:]]*([0-9]+)[[:space:]]*;/, p)) code[p[1]] = p[2]
    next
  }
  match($0, /^  ([A-Za-z0-9_]+):$/, p) { key = p[1]; next }
  match($0, /^[[:space:]]+real:[[:space:]]+(Shift|Control|Mod1|Mod4)$/, p) && code[key] {
    role = p[1] == "Shift" ? "shift" : (p[1] == "Control" ? "ctrl" : (p[1] == "Mod1" ? "alt" : "super"))
    bit = p[1] == "Shift" ? 1 : (p[1] == "Control" ? 4 : (p[1] == "Mod1" ? 8 : 64))
    count[role]++
    print code[key], role "_" count[role], bit
  }
' "$keymap" "$modmaps" >"$entries"
grep -q ' super_' "$entries" || { printf 'install-bindings: active Super modifier has no XKB keys\n' >&2; exit 65; }

awk -v begin="$begin_marker" -v end="$end_marker" '
  $0 == begin { in_owned_block = 1; next }
  in_owned_block && $0 == end { in_owned_block = 0; next }
  !in_owned_block { print }
  END {
    if (in_owned_block) exit 65
  }
' "$config" >"$temporary"

{
  printf '%s\n' "$begin_marker"
  printf '%s\n' 'local omarchy_which_key_codes = {'
  while read -r code name bit; do printf '  [%s] = { name = "%s", bit = %s },\n' "$code" "$name" "$bit"; done <"$entries"
  printf '%s\n' '}'
  printf '%s\n' 'local omarchy_which_key_bits = {'
  while read -r _ name bit; do printf '  %s = %s,\n' "$name" "$bit"; done <"$entries"
  printf '%s\n' '}'
  printf '%s\n' 'local omarchy_which_key_held = {}'
  printf '%s\n' 'hl.on("input.keyboard.key", function(keycode, time, state)'
  printf '%s\n' '  local key = omarchy_which_key_codes[keycode]'
  printf '%s\n' '  -- Only a modifier change moves the guide. A shortcut key is ignored so'
  printf '%s\n' '  -- that one held Super can run several shortcuts in a row.'
  printf '%s\n' '  if not key then return end'
  printf '%s\n' '  local pressed = state == 1'
  printf '%s\n' '  omarchy_which_key_held[key.name] = pressed or nil'
  printf '%s\n' '  local mask = 0'
  printf '%s\n' '  for name, _ in pairs(omarchy_which_key_held) do'
  printf '%s\n' '    mask = mask | omarchy_which_key_bits[name]'
  printf '%s\n' '  end'
  printf '%s\n' '  hl.exec_cmd("which-key-trigger state " .. tostring(time) .. " " .. tostring(mask))'
  printf '%s\n' 'end)'
  printf '%s\n' "$end_marker"
} >>"$temporary"

chmod --reference="$config" "$temporary"
mv -f -- "$temporary" "$config"
trap - EXIT
