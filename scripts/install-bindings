#!/bin/bash

set -euo pipefail

begin_marker='-- omarchy-which-key:begin'
end_marker='-- omarchy-which-key:end'
config="${OMARCHY_WHICH_KEY_HYPR_CONFIG:-${HOME}/.config/hypr/bindings.lua}"
config_dir="$(dirname "$config")"
xkbcli_command="${OMARCHY_WHICH_KEY_XKBCLI:-xkbcli}"

mkdir -p "$config_dir"
if [[ ! -e "$config" ]]; then
  : >"$config"
fi

if ! grep -Fqx -- "$begin_marker" "$config"; then
  backup="${config}.bak.$(date +%s%N)"
  cp -p -- "$config" "$backup"
fi

temporary="$(mktemp "${config}.tmp.XXXXXX")"
keymap="$(mktemp)"
cleanup() {
  rm -f -- "$temporary" "$keymap"
}
trap cleanup EXIT

"$xkbcli_command" compile-keymap </dev/null >"$keymap"

keycode_for() {
  local key_name="$1"
  local code
  code="$(awk -v wanted="$key_name" '
    match($0, /<([A-Za-z0-9_]+)>[[:space:]]*=[[:space:]]*([0-9]+)[[:space:]]*;/, parts) {
      if (parts[1] == wanted) {
        print parts[2]
        exit
      }
    }
  ' "$keymap")"
  if [[ -z "$code" ]]; then
    printf 'install-bindings: XKB keycode not found for %s\n' "$key_name" >&2
    exit 65
  fi
  printf '%s' "$code"
}

left_shift="$(keycode_for LFSH)"
right_shift="$(keycode_for RTSH)"
left_ctrl="$(keycode_for LCTL)"
right_ctrl="$(keycode_for RCTL)"
left_alt="$(keycode_for LALT)"
right_alt="$(keycode_for RALT)"
left_super="$(keycode_for LWIN)"
right_super="$(keycode_for RWIN)"

awk -v begin="$begin_marker" -v end="$end_marker" '
  $0 == begin { in_owned_block = 1; next }
  in_owned_block && $0 == end { in_owned_block = 0; next }
  !in_owned_block { print }
  END {
    if (in_owned_block) exit 65
  }
' "$config" >"$temporary"

{
  printf '%s\n' "$begin_marker"
  printf '%s\n' 'local omarchy_which_key_codes = {'
  printf '  [%s] = { name = "super_l", bit = 64 },\n' "$left_super"
  printf '  [%s] = { name = "super_r", bit = 64 },\n' "$right_super"
  printf '  [%s] = { name = "shift_l", bit = 1 },\n' "$left_shift"
  printf '  [%s] = { name = "shift_r", bit = 1 },\n' "$right_shift"
  printf '  [%s] = { name = "ctrl_l", bit = 4 },\n' "$left_ctrl"
  printf '  [%s] = { name = "ctrl_r", bit = 4 },\n' "$right_ctrl"
  printf '  [%s] = { name = "alt_l", bit = 8 },\n' "$left_alt"
  printf '  [%s] = { name = "alt_r", bit = 8 },\n' "$right_alt"
  printf '%s\n' '}'
  printf '%s\n' 'local omarchy_which_key_bits = {'
  printf '%s\n' '  super_l = 64, super_r = 64,'
  printf '%s\n' '  shift_l = 1, shift_r = 1,'
  printf '%s\n' '  ctrl_l = 4, ctrl_r = 4,'
  printf '%s\n' '  alt_l = 8, alt_r = 8,'
  printf '%s\n' '}'
  printf '%s\n' 'local omarchy_which_key_held = {}'
  printf '%s\n' 'hl.on("input.keyboard.key", function(keycode, _, state)'
  printf '%s\n' '  local key = omarchy_which_key_codes[keycode]'
  printf '%s\n' '  if not key then return end'
  printf '%s\n' '  local pressed = state == 1'
  printf '%s\n' '  omarchy_which_key_held[key.name] = pressed or nil'
  printf '%s\n' '  local mask = 0'
  printf '%s\n' '  for name, _ in pairs(omarchy_which_key_held) do'
  printf '%s\n' '    mask = mask | omarchy_which_key_bits[name]'
  printf '%s\n' '  end'
  printf '%s\n' '  if key.bit == 64 then'
  printf '%s\n' '    hl.exec_cmd("which-key-trigger " .. (pressed and "press" or "release") .. " " .. key.name)'
  printf '%s\n' '  end'
  printf '%s\n' '  hl.exec_cmd("which-key-trigger modifiers " .. tostring(mask))'
  printf '%s\n' 'end)'
  printf '%s\n' "$end_marker"
} >>"$temporary"

chmod --reference="$config" "$temporary"
mv -f -- "$temporary" "$config"
trap - EXIT
